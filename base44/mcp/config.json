{
  "auth": "oauth",
  "login_path": "/login",
  "consent_path": "/oauth/consent",
  "tools": {
    "excluded_agents": [
      "evidence_analyst",
      "search_strategist"
    ],
    "entity_overrides": {
      "SavedOpportunity": {
        "operations": []
      },
      "Opportunity": {
        "operations": []
      },
      "EvidenceItem": {
        "operations": []
      },
      "LeadSearch": {
        "operations": []
      },
      "OpportunityFeedback": {
        "operations": []
      },
      "UserProfile": {
        "operations": []
      },
      "EmailCampaignContent": {
        "operations": []
      },
      "PayPalSubscription": {
        "operations": []
      },
      "PayPalWebhookEvent": {
        "operations": []
      },
      "PaymentWebhookEvent": {
        "operations": []
      },
      "PilotEnrollment": {
        "operations": []
      },
      "User": {
        "operations": []
      },
      "AdminCollaborator": {
        "operations": []
      },
      "ProAccessGrant": {
        "operations": []
      },
      "ProductSurveyFeedback": {
        "operations": []
      },
      "SubscriptionRecoveryEvent": {
        "operations": []
      }
    },
    "functions": [
      {
        "name": "list_saved_leads",
        "title": "List saved leads (read-only)",
        "description": "Read-only query of your own saved GoLeads leads. Free accounts can run basic read-only queries (up to 5 recent saved leads with business name, category, location, signal type, verification status, source URL, and stage). GoLeads Pro accounts can run full read-only queries (up to 50 saved leads including website, public email/phone, Google Maps venue details, signal summary, notes, and outreach draft). Strictly read-only: cannot create, modify, or delete any data.",
        "input_schema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "description": "Maximum number of saved leads to return (up to 5 on Free plan, up to 50 on Pro plan).",
              "default": 20
            },
            "stage": {
              "type": "string",
              "enum": [
                "all",
                "saved",
                "researching",
                "qualified",
                "archived"
              ],
              "description": "Optional review stage filter (defaults to all)."
            }
          }
        },
        "annotations": {
          "read_only_hint": true,
          "destructive_hint": false,
          "idempotent_hint": true,
          "open_world_hint": false
        },
        "handler": "/api/mcp-leads",
        "method": "post",
        "disabled": false
      }
    ]
  }
}