{
  "auth": "oauth",
  "login_path": "/login",
  "consent_path": "/oauth/consent",
  "tools": {
    "excluded_agents": [
      "evidence_analyst",
      "search_strategist"
    ],
    "entity_overrides": {
      "SavedOpportunity": {
        "operations": []
      },
      "Opportunity": {
        "operations": []
      },
      "EvidenceItem": {
        "operations": []
      },
      "LeadSearch": {
        "operations": []
      },
      "OpportunityFeedback": {
        "operations": []
      },
      "UserProfile": {
        "operations": []
      },
      "EmailCampaignContent": {
        "operations": []
      },
      "PayPalSubscription": {
        "operations": []
      },
      "PayPalWebhookEvent": {
        "operations": []
      },
      "PaymentWebhookEvent": {
        "operations": []
      },
      "PilotEnrollment": {
        "operations": []
      },
      "User": {
        "operations": []
      },
      "AdminCollaborator": {
        "operations": []
      },
      "ProAccessGrant": {
        "operations": []
      }
    },
    "functions": [
      {
        "name": "list_saved_leads",
        "title": "List saved leads",
        "description": "Read up to 50 of your own saved GoLeads leads (business name, category, location, website, public email/phone, Google Maps venue details, expansion signal, source URL, review stage, and outreach draft). Requires an active GoLeads Pro plan. Read-only: no write operations, administrative data, or payment information.",
        "input_schema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "description": "Maximum number of saved leads to return (1-50, defaults to 20).",
              "default": 20
            },
            "stage": {
              "type": "string",
              "enum": [
                "all",
                "saved",
                "researching",
                "qualified",
                "archived"
              ],
              "description": "Optional review stage filter (defaults to all)."
            }
          }
        },
        "annotations": {
          "read_only_hint": true,
          "destructive_hint": false,
          "idempotent_hint": true,
          "open_world_hint": false
        },
        "handler": "/api/mcp-leads",
        "method": "post",
        "disabled": false
      }
    ]
  }
}