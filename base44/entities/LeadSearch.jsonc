{
  "name": "LeadSearch",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Authenticated user ID derived on the server"
    },
    "business_category": {
      "type": "string",
      "description": "Target business category searched"
    },
    "location_query": {
      "type": "string",
      "description": "City / country searched"
    },
    "time_window_days": {
      "type": "number",
      "enum": [
        30,
        90,
        180
      ],
      "default": 90
    },
    "query_cache_key": {
      "type": "string",
      "description": "Normalized per-user cache key for category, location, and time window"
    },
    "selected_services_snapshot": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "service_description_snapshot": {
      "type": "string",
      "description": "Snapshot of the user's optional service description when the search ran"
    },
    "status": {
      "type": "string",
      "enum": [
        "not_configured",
        "ready",
        "searching",
        "partial",
        "empty",
        "failed",
        "completed"
      ],
      "default": "not_configured"
    },
    "honest_status_reason": {
      "type": "string",
      "description": "Explicit explanation of search status, verification summary, or failure reason"
    },
    "results_count": {
      "type": "number",
      "default": 0
    },
    "verified_count": {
      "type": "number",
      "default": 0
    },
    "needs_review_count": {
      "type": "number",
      "default": 0
    },
    "counts_toward_quota": {
      "type": "boolean",
      "default": true
    },
    "cached_from_search_id": {
      "type": "string",
      "description": "Original search ID if served from 24-hour cache"
    },
    "duration_ms": {
      "type": "number",
      "description": "Observed execution time in milliseconds"
    },
    "executed_at": {
      "type": "string",
      "description": "ISO timestamp when search record was created"
    },
    "completed_at": {
      "type": "string",
      "description": "ISO timestamp when search finished"
    }
  },
  "required": [
    "owner_id",
    "business_category",
    "location_query",
    "time_window_days",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}