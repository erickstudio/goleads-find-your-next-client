{
  "name": "LeadSearch",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Authenticated user ID derived on the server"
    },
    "business_category": {
      "type": "string",
      "description": "Target business category searched"
    },
    "location_query": {
      "type": "string",
      "description": "City / country searched"
    },
    "time_window_days": {
      "type": "number",
      "enum": [
        30,
        90,
        180
      ],
      "default": 90
    },
    "selected_services_snapshot": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "status": {
      "type": "string",
      "enum": [
        "not_configured",
        "ready",
        "searching",
        "partial",
        "empty",
        "failed",
        "completed"
      ],
      "default": "not_configured"
    },
    "honest_status_reason": {
      "type": "string",
      "description": "Explicit explanation of search status or why live discovery did not run"
    },
    "results_count": {
      "type": "number",
      "default": 0
    },
    "executed_at": {
      "type": "string",
      "description": "ISO timestamp when search record was created"
    }
  },
  "required": [
    "owner_id",
    "business_category",
    "location_query",
    "time_window_days",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}