{
  "name": "OpportunityFeedback",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Authenticated user ID derived on the server"
    },
    "opportunity_id": {
      "type": "string",
      "description": "Target Opportunity ID"
    },
    "business_name": {
      "type": "string"
    },
    "verdict": {
      "type": "string",
      "enum": [
        "relevant",
        "not_relevant",
        "weak_evidence",
        "already_client",
        "out_of_territory"
      ],
      "description": "User relevance rating for this opportunity"
    },
    "reason_category": {
      "type": "string",
      "description": "Optional concise reason tag selected by the user"
    },
    "reason_note": {
      "type": "string",
      "description": "Optional user-supplied explanation for the relevance rating"
    },
    "recorded_at": {
      "type": "string",
      "description": "ISO timestamp when feedback was created or last updated"
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "owner_id",
    "opportunity_id",
    "verdict"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}