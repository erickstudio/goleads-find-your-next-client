{
  "name": "UserProfile",
  "type": "object",
  "properties": {
    "owner_id": {
      "type": "string",
      "description": "Authenticated user ID derived on the server"
    },
    "owner_email": {
      "type": "string",
      "description": "Authenticated user email derived on the server"
    },
    "selected_services": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "One or more user-defined business service names offered by the user"
    },
    "service_description": {
      "type": "string",
      "description": "Optional plain-language description of what the user sells and who they help"
    },
    "agency_or_freelancer_name": {
      "type": "string",
      "description": "Optional working name or practice label"
    },
    "default_time_window_days": {
      "type": "number",
      "enum": [
        30,
        90,
        180
      ],
      "default": 90
    },
    "ui_language": {
      "type": "string",
      "enum": [
        "en",
        "es"
      ],
      "description": "Preferred interface language (en or es)"
    },
    "outreach_language": {
      "type": "string",
      "enum": [
        "en",
        "es"
      ],
      "description": "Preferred outreach draft language, kept separate from UI language"
    },
    "theme_preference": {
      "type": "string",
      "enum": [
        "light",
        "dark",
        "system"
      ],
      "description": "Preferred color theme mode (light, dark, or system)"
    },
    "enable_search_strategist": {
      "type": "boolean",
      "default": true,
      "description": "Whether the Search Strategist AI agent is enabled in the workspace"
    },
    "enable_evidence_analyst": {
      "type": "boolean",
      "default": true,
      "description": "Whether the Evidence & Relevance Analyst AI agent is enabled in the workspace"
    },
    "onboarding_completed": {
      "type": "boolean",
      "default": false
    },
    "description": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "owner_id",
    "selected_services"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}